# erickscur.com.br — Apache (HostGator, plano compartilhado)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

# ------------------------------------------------------------------ HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On

  # força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → sem www (endereço canônico: https://erickscur.com.br)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------ tipos MIME
<IfModule mod_mime.c>
  AddType text/javascript              .js .mjs
  AddType font/woff2                   .woff2
  AddType image/avif                   .avif
  AddType image/webp                   .webp
  AddType image/svg+xml                .svg
  AddType application/manifest+json    .webmanifest
</IfModule>

# ------------------------------------------------------------- compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/plain application/xml text/xml
</IfModule>

# ------------------------------------------------------------------ cache
# CSS e JS levam ?v=AAAA.MM.DD no HTML. Ao mudar um deles, troque o ?v= em
# todas as páginas (o README explica) e o navegador baixa a versão nova.
# Bibliotecas e fontes têm a versão no nome do arquivo.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 hour"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 month"
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# ferramentas e material de revisão não são parte do site (caso subam junto)
<IfModule mod_rewrite.c>
  RewriteRule ^(scripts|revisao)(/|$) - [F,L]
</IfModule>
<FilesMatch "^(README\.md|.*\.py|.*\.mp4)$">
  Require all denied
</FilesMatch>

# não servir arquivos de sistema/ocultos
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

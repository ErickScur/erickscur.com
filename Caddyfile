# erickscur.com.br — Caddy na Railway (equivale ao .htaccess da HostGator).
# A Railway termina o HTTPS na borda e passa a porta em $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# o domínio antigo (.com) vai para o oficial
	@antigo host erickscur.com www.erickscur.com
	redir @antigo https://erickscur.com.br{uri} permanent

	# www → sem www (endereço canônico: https://erickscur.com.br)
	@www header_regexp host Host ^www\.(.+)$
	redir @www https://{re.host.1}{uri} permanent

	# ferramentas, material de revisão e arquivos ocultos não são o site
	@privado path /scripts/* /revisao/* /README.md *.py *.mp4 /.* /Caddyfile /Dockerfile
	error @privado 404

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# cache: CSS e JS levam ?v= no HTML; vendor e fontes têm a versão no nome
	@imutavel path *.css *.js *.woff2
	header @imutavel Cache-Control "public, max-age=31536000, immutable"
	@fontes path *.woff2
	header @fontes Access-Control-Allow-Origin "*"
	@imagens path *.avif *.webp *.png *.svg *.jpg
	header @imagens Cache-Control "public, max-age=2592000"
	@manifest path *.webmanifest
	header @manifest Cache-Control "public, max-age=604800"
	@html path / *.html
	header @html Cache-Control "no-cache"

	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			header Cache-Control "no-cache"
			file_server {
				status 404
			}
		}
	}
}
